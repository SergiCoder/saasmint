# SaaSmint — environment template.  Copy to .env.local and fill in your secrets:
#   cp .env.example .env.local      (or: make setup)
#
# One file per environment: .env.local (dev), .env.staging (the VPS), .env.production.
# Only .env.example is committed. NEXT_PUBLIC_* are BUILD-TIME (baked into the frontend
# bundle); everything else is backend runtime config.
#
# Boundary values shared across the stack are defined ONCE here:
#   FRONTEND_URL (core)        == NEXT_PUBLIC_APP_URL (app)            → the app's URL
#   the Caddy TLS proxy :8443  == NEXT_PUBLIC_API_URL (app)            → the API URL
#   STRIPE_SECRET_KEY (sk_)    pairs with NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY (pk_)
#   RECAPTCHA_SECRET_KEY       pairs with NEXT_PUBLIC_RECAPTCHA_SITE_KEY

# ─── core · App ───────────────────────────────────────────────────────────────
ENVIRONMENT=local

# ─── core · Django ────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_PORT=8001
DJANGO_STATIC_ROOT=/app/staticfiles
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CSRF_TRUSTED_ORIGINS=["https://localhost:8443","https://localhost:3000"]
CORS_ALLOWED_ORIGINS=[]
CORS_ALLOW_ALL_ORIGINS=false  # true only for local development
ENABLE_SESSION_AUTH=true

# ─── core · Database (Postgres) ───────────────────────────────────────────────
POSTGRES_DB=saasmint
POSTGRES_USER=saasmint
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://saasmint:@localhost:5432/saasmint

# ─── core · Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── core · Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── core · Email (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@saasmint.net
FRONTEND_URL=https://localhost:3000        # == NEXT_PUBLIC_APP_URL below

# ─── core · Marketing inquiries ───────────────────────────────────────────────
MARKETING_INQUIRIES_TO=hello@saasmint.net

# ─── core · OAuth ─────────────────────────────────────────────────────────────
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# ─── core · reCAPTCHA (v3) ────────────────────────────────────────────────────
RECAPTCHA_SECRET_KEY=                       # pairs with NEXT_PUBLIC_RECAPTCHA_SITE_KEY; empty = disabled
RECAPTCHA_MIN_SCORE=0.5

# ─── app · Public (BUILD-TIME — baked into the frontend bundle) ──────────────
NEXT_PUBLIC_API_URL=https://localhost:8443          # the Caddy TLS proxy in front of Django
NEXT_PUBLIC_APP_URL=https://localhost:3000          # == FRONTEND_URL above
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key # pairs with STRIPE_SECRET_KEY
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=                     # pairs with RECAPTCHA_SECRET_KEY
